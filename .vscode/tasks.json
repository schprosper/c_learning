{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: gcc.exe build active file",
            "command": "C:\\mingw64\\bin\\gcc.exe",
            "args": [
                //"-Wall",
                "-fdiagnostics-color=always",
                "-g",
                "-std=c17",//原本没有
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe",
                //"${workspaceFolder}/my_program.exe"//是否直接同时编译
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger.编译单个文件临时调试"
        }
        
    ],
    "version": "2.0.0"
}

